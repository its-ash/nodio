<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CommandString</key>
	<string>clear; if [ -d /Applications/Nodio.app ]; then xattr -dr com.apple.quarantine /Applications/Nodio.app &amp;&amp; echo "Done. Open Nodio from Applications. You can close this window."; else echo "Nodio is not in Applications. Drag Nodio to Applications, then open this file again."; fi</string>
	<key>ProfileCurrentVersion</key>
	<real>2.07</real>
	<key>RunCommandAsShell</key>
	<false/>
	<key>name</key>
	<string>Fix Nodio</string>
	<key>type</key>
	<string>Window Settings</string>
</dict>
</plist>
